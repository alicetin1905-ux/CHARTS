//@version=6
// EMA Ribbon Flip — BTCUSDT.P (Bybit)
// Uses the same 8 EMAs as "EMA Ribbon [Krypt]" (20/25/30/35/40/45/50/55).
//
// Entry idea: the ribbon squeezes until the EMAs sit on (almost) one line, then "flips":
//   LONG  when all 8 EMAs line up bullish (fastest on top, slowest at the bottom)
//   SHORT when all 8 EMAs line up bearish (fastest at the bottom, slowest on top)
// The opposite flip closes and reverses the trade. An ATR stop limits losses in between.
//
// Signals are taken on the bar close and filled at the next bar's open (no repainting).
// Tested defaults are for the 4H chart. On 15m it lost money in testing — see README.
strategy("EMA Ribbon Flip [Krypt ribbon] — BTCUSDT.P", shorttitle = "Ribbon Flip", overlay = true,
     initial_capital = 1000, currency = currency.USDT,
     default_qty_type = strategy.percent_of_equity, default_qty_value = 100,
     commission_type = strategy.commission.percent, commission_value = 0.055,   // Bybit taker fee
     slippage = 10, pyramiding = 0, margin_long = 10, margin_short = 10)

// ───────── Inputs ─────────
const string G_RIB  = "EMA Ribbon (match your Krypt settings)"
src  = input.source(close, "Source", group = G_RIB)
len1 = input.int(20, "EMA 1 (fastest)", minval = 1, group = G_RIB)
len2 = input.int(25, "EMA 2", minval = 1, group = G_RIB)
len3 = input.int(30, "EMA 3", minval = 1, group = G_RIB)
len4 = input.int(35, "EMA 4", minval = 1, group = G_RIB)
len5 = input.int(40, "EMA 5", minval = 1, group = G_RIB)
len6 = input.int(45, "EMA 6", minval = 1, group = G_RIB)
len7 = input.int(50, "EMA 7", minval = 1, group = G_RIB)
len8 = input.int(55, "EMA 8 (slowest)", minval = 1, group = G_RIB)

const string G_SIG   = "Entry signal"
const string T_STACK = "Full flip (all 8 EMAs re-order)"
const string T_CROSS = "Fast/slow cross (EMA 1 x EMA 8)"
trigger   = input.string(T_STACK, "Flip trigger", options = [T_STACK, T_CROSS], group = G_SIG)
useSqueeze = input.bool(true, "Only trade flips that start from a squeeze (EMAs on one line)", group = G_SIG)
squeezePct = input.float(0.6, "  Squeeze: ribbon width ≤ % of price", minval = 0.05, step = 0.05, group = G_SIG,
     tooltip = "Width = (highest EMA − lowest EMA) / price. 0.6% on 4H ≈ the ribbon looks like a single line.")
squeezeLb  = input.int(10, "  Squeeze must have happened within last N bars", minval = 1, group = G_SIG)
direction  = input.string("Long & Short", "Trade direction", options = ["Long & Short", "Long only", "Short only"], group = G_SIG)

const string G_RISK = "Risk / exits"
const string X_REV  = "Opposite flip (reverse)"
const string X_FAST = "EMA 1 crosses back over EMA 2"
exitMode = input.string(X_REV, "Close trade on", options = [X_REV, X_FAST], group = G_RISK)
useSL    = input.bool(true, "ATR stop-loss", group = G_RISK)
atrLen   = input.int(14, "  ATR length", minval = 1, group = G_RISK)
slMult   = input.float(2.5, "  Stop distance (× ATR)", minval = 0.1, step = 0.1, group = G_RISK)
useTP    = input.bool(false, "Take-profit", group = G_RISK)
tpR      = input.float(2.0, "  Take-profit (× stop distance)", minval = 0.1, step = 0.1, group = G_RISK)
equityPct = input.float(100, "Position size (% of equity, as margin)", minval = 1, maxval = 100, group = G_RISK)
leverage  = input.float(1, "Leverage", minval = 1, maxval = 10, step = 1, group = G_RISK,
     tooltip = "Backtest supports up to 10×. Start with 1–3× — drawdowns in testing reached ~30% unleveraged.")

const string G_MISC = "Backtest window / visuals"
startTime  = input.time(timestamp("01 Jan 2023 00:00 +0000"), "Start date", group = G_MISC)
showRibbon = input.bool(true, "Show ribbon", group = G_MISC)
showSq     = input.bool(true, "Shade squeeze zones", group = G_MISC)

// ───────── Ribbon ─────────
e1 = ta.ema(src, len1)
e2 = ta.ema(src, len2)
e3 = ta.ema(src, len3)
e4 = ta.ema(src, len4)
e5 = ta.ema(src, len5)
e6 = ta.ema(src, len6)
e7 = ta.ema(src, len7)
e8 = ta.ema(src, len8)

bool bullStack = e1 > e2 and e2 > e3 and e3 > e4 and e4 > e5 and e5 > e6 and e6 > e7 and e7 > e8
bool bearStack = e1 < e2 and e2 < e3 and e3 < e4 and e4 < e5 and e5 < e6 and e6 < e7 and e7 < e8

float ribHi   = math.max(e1, e2, e3, e4, e5, e6, e7, e8)
float ribLo   = math.min(e1, e2, e3, e4, e5, e6, e7, e8)
float widthPct = (ribHi - ribLo) / close * 100
bool squeezeNow = widthPct <= squeezePct
bool squeezed   = ta.lowest(widthPct, squeezeLb) <= squeezePct

// ───────── Signals ─────────
bool crossUp   = ta.crossover(e1, e8)
bool crossDown = ta.crossunder(e1, e8)
bool longFlip  = trigger == T_STACK ? bullStack and not bullStack[1] : crossUp
bool shortFlip = trigger == T_STACK ? bearStack and not bearStack[1] : crossDown
if useSqueeze
    longFlip  := longFlip and squeezed
    shortFlip := shortFlip and squeezed

bool inWindow   = time >= startTime
bool allowLong  = direction != "Short only"
bool allowShort = direction != "Long only"
bool goLong  = inWindow and longFlip and allowLong
bool goShort = inWindow and shortFlip and allowShort

float atr = ta.atr(atrLen)
var float entryAtr = na
float qty = strategy.equity * equityPct / 100 * leverage / close

// ───────── Orders ─────────
if goLong
    strategy.entry("Long", strategy.long, qty = qty)
    entryAtr := atr
    alert("BTCUSDT.P LONG — EMA ribbon flipped bullish at " + str.tostring(close), alert.freq_once_per_bar_close)
else if goShort
    strategy.entry("Short", strategy.short, qty = qty)
    entryAtr := atr
    alert("BTCUSDT.P SHORT — EMA ribbon flipped bearish at " + str.tostring(close), alert.freq_once_per_bar_close)

// Opposite flip when that side is disabled: just close
if shortFlip and not allowShort and strategy.position_size > 0
    strategy.close("Long", comment = "Flip")
if longFlip and not allowLong and strategy.position_size < 0
    strategy.close("Short", comment = "Flip")

if exitMode == X_FAST
    if strategy.position_size > 0 and e1 < e2 and not goShort
        strategy.close("Long", comment = "EMA1<EMA2")
    if strategy.position_size < 0 and e1 > e2 and not goLong
        strategy.close("Short", comment = "EMA1>EMA2")

// Stop / target — measured from the fill price once in the trade, from the signal close before that
if useSL or useTP
    float longBase  = strategy.position_size > 0 ? strategy.position_avg_price : close
    float shortBase = strategy.position_size < 0 ? strategy.position_avg_price : close
    float dist = slMult * entryAtr
    strategy.exit("L exit", "Long",  stop = useSL ? longBase - dist : na,  limit = useTP ? longBase + dist * tpR : na,
         comment_loss = "SL", comment_profit = "TP")
    strategy.exit("S exit", "Short", stop = useSL ? shortBase + dist : na, limit = useTP ? shortBase - dist * tpR : na,
         comment_loss = "SL", comment_profit = "TP")

// ───────── Visuals ─────────
color ribColor = bullStack ? color.new(#00e676, 0) : bearStack ? color.new(#ff5252, 0) : color.new(#9e9e9e, 0)
plot(showRibbon ? e1 : na, "EMA 1", ribColor, 2)
plot(showRibbon ? e2 : na, "EMA 2", color.new(ribColor, 15))
plot(showRibbon ? e3 : na, "EMA 3", color.new(ribColor, 25))
plot(showRibbon ? e4 : na, "EMA 4", color.new(ribColor, 35))
plot(showRibbon ? e5 : na, "EMA 5", color.new(ribColor, 45))
plot(showRibbon ? e6 : na, "EMA 6", color.new(ribColor, 55))
plot(showRibbon ? e7 : na, "EMA 7", color.new(ribColor, 65))
plot(showRibbon ? e8 : na, "EMA 8", ribColor, 2)

bgcolor(showSq and squeezeNow ? color.new(#ffd600, 88) : na, title = "Squeeze")
plotshape(goLong,  "Long flip",  shape.triangleup,   location.belowbar, #00e676, size = size.small, text = "LONG")
plotshape(goShort, "Short flip", shape.triangledown, location.abovebar, #ff5252, size = size.small, text = "SHORT")
