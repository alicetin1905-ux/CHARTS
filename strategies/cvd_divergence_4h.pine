// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// The BUY / SELL signals of the Delta Volume indicator (indicators/delta_volume.pine) as a strategy, with delta
// built from 1H intrabars. Built for BINANCE:BTCUSDT.P / BYBIT:BTCUSDT.P on the 4-hour chart.
// Backtest: scripts/cvd_divergence_1h.py and backtests/cvd_divergence_1h.md in this repository
// (Binance, Oct 2020 - Sep 2026: PF 1.74, +274%, max drawdown 39%, ~15 trades a year).
//
// Delta : each 1H intrabar counts as buying if it closed up, selling if down (flat: direction of the last move).
//         CVD = running sum of delta.
// Signal: a price pivot (5 bars left, 3 right) against the previous pivot of the same kind 5-60 bars earlier.
//         Bullish divergence = lower low in price, higher CVD. It arms a trigger at the highest high since the
//         pivot; BUY when a candle closes above it with positive delta within 10 bars, unless price breaks the
//         pivot low first or a bearish divergence appears. SELL is the mirror image.
// Trade : enter at the next open; stop at the divergence pivot; the opposite signal closes and reverses; a repeat
//         signal in the same direction is ignored. Optional take profit at a multiple of the stop distance.
//
// Costs: commission 0.075% per side covers taker fee + slippage, as in the Python backtest.
// margin_long / margin_short = 50: with 100% of equity per trade, Pine v6's default 100% margin makes
// TradingView force-close parts of positions ("Margin call" trades) once commission is paid. 50% margin
// leaves the 1x position untouched.
// use_bar_magnifier: with a Premium plan, stops and targets are filled on lower-timeframe data like the Python
// backtest (on 1m); without it TradingView guesses the order of the high and low inside each 4H candle.

//@version=6
strategy("CVD Divergence [BTC 4H]", overlay = true, initial_capital = 10000,
     default_qty_type = strategy.percent_of_equity, default_qty_value = 100, pyramiding = 0,
     margin_long = 50, margin_short = 50, use_bar_magnifier = true,
     commission_type = strategy.commission.percent, commission_value = 0.075, slippage = 0)

// Strategy Tester results are only real on standard candles (not Heikin Ashi, Renko, Line Break, Kagi, ...).
if not chart.is_standard
    runtime.error("Switch the chart type to Candles (or Bars): this strategy only backtests on standard charts.")

ltf         = input.timeframe("60", "Delta from intrabars of", tooltip = "1 hour tested best on 4H. Must be lower than the chart timeframe.")
pivLeft     = input.int(5, "Pivot bars left", minval = 1)
pivRight    = input.int(3, "Pivot bars right", minval = 1)
rangeMin    = input.int(5, "Min bars between pivots", minval = 1)
rangeMax    = input.int(60, "Max bars between pivots", minval = 2)
confirmBars = input.int(10, "Bars to confirm", minval = 1)
needDelta   = input.bool(true, "Confirmation candle needs matching delta")
sigHidden   = input.bool(false, "Also trade hidden divergences")
shorts      = input.bool(true, "Trade shorts", tooltip = "Off: SELL signals only close longs.")
tpR         = input.float(0, "Take profit (x stop distance, 0 = off)", minval = 0, step = 0.5,
     tooltip = "0 = hold until the stop or the opposite signal (the best backtest). 2 = the 2R variant.")
startDate   = input.time(timestamp("2020-10-01T00:00:00Z"), "Trade from", tooltip = "The Python backtest starts on 1 Oct 2020.")

if timeframe.in_seconds(ltf) >= timeframe.in_seconds()
    runtime.error("The intrabar timeframe (" + ltf + ") must be lower than the chart timeframe.")

// Delta from intrabars, as in the indicator.
[ltfO, ltfC, ltfV] = request.security_lower_tf(syminfo.tickerid, ltf, [open, close, volume])
var float lastDir   = 1.0
var float lastClose = na
float delta = 0.0
int n = ltfC.size()
if n > 0
    for i = 0 to n - 1
        float ic = ltfC.get(i)
        float io = ltfO.get(i)
        float dir = ic > io ? 1.0 : ic < io ? -1.0 : ic > lastClose ? 1.0 : ic < lastClose ? -1.0 : lastDir
        delta     += dir * nz(ltfV.get(i))
        lastDir   := dir
        lastClose := ic
else
    // No intrabar data for this bar: estimate from the candle, like the indicator's fallback.
    buyShare = high > low ? (close - low) / (high - low) : close > open ? 1.0 : close < open ? 0.0 : 0.5
    delta := volume * (2 * buyShare - 1)
    lastClose := close
var float cvd = 0.0
cvd += delta

// Divergences on price pivots.
pivLow   = ta.pivotlow(low, pivLeft, pivRight)
pivHigh  = ta.pivothigh(high, pivLeft, pivRight)
pivBar   = bar_index - pivRight
cvdAtPiv = cvd[pivRight]

var float prevLowPrice  = na
var float prevLowCvd    = na
var int   prevLowBar    = na
var float prevHighPrice = na
var float prevHighCvd   = na
var int   prevHighBar   = na

bool bullDiv = false
bool bearDiv = false
if not na(pivLow)
    int dist = pivBar - prevLowBar
    if not na(prevLowBar) and dist >= rangeMin and dist <= rangeMax
        bullDiv := (pivLow < prevLowPrice and cvdAtPiv > prevLowCvd) or (sigHidden and pivLow > prevLowPrice and cvdAtPiv < prevLowCvd)
    prevLowPrice := pivLow
    prevLowCvd   := cvdAtPiv
    prevLowBar   := pivBar
if not na(pivHigh)
    int dist = pivBar - prevHighBar
    if not na(prevHighBar) and dist >= rangeMin and dist <= rangeMax
        bearDiv := (pivHigh > prevHighPrice and cvdAtPiv < prevHighCvd) or (sigHidden and pivHigh < prevHighPrice and cvdAtPiv > prevHighCvd)
    prevHighPrice := pivHigh
    prevHighCvd   := cvdAtPiv
    prevHighBar   := pivBar

// Confirmation: pending triggers are checked before new ones are armed.
hiSincePiv = ta.highest(high, pivRight + 1)
loSincePiv = ta.lowest(low, pivRight + 1)

var float buyLevel   = na
var float buyStop    = na
var int   buyExpire  = na
var float sellLevel  = na
var float sellStop   = na
var int   sellExpire = na

bool  buySig      = false
bool  sellSig     = false
float buySigStop  = na
float sellSigStop = na

if not na(buyLevel)
    if low < buyStop or bar_index > buyExpire
        buyLevel := na
    else if close > buyLevel and (not needDelta or delta > 0)
        buySig     := true
        buySigStop := buyStop
        buyLevel := na
if not na(sellLevel)
    if high > sellStop or bar_index > sellExpire
        sellLevel := na
    else if close < sellLevel and (not needDelta or delta < 0)
        sellSig     := true
        sellSigStop := sellStop
        sellLevel := na

if bullDiv
    buyLevel  := hiSincePiv
    buyStop   := pivLow
    buyExpire := bar_index + confirmBars
    if not bearDiv
        sellLevel := na
if bearDiv
    sellLevel  := loSincePiv
    sellStop   := pivHigh
    sellExpire := bar_index + confirmBars
    if not bullDiv
        buyLevel := na

// Orders. Each side keeps the stop of the signal that opened it; a repeat signal does not move it.
// The exit is placed on the signal bar, so the stop protects the trade from the fill at the next open; the
// target is first set from the signal close, then from the fill price.
var float longStop  = na
var float shortStop = na
inWindow = time >= startDate

bool goLong  = buySig and inWindow and strategy.position_size <= 0
bool goShort = sellSig and inWindow and shorts and strategy.position_size >= 0 and not goLong
if goLong
    strategy.entry("L", strategy.long)    // also reverses a short
    longStop := buySigStop
if goShort
    strategy.entry("S", strategy.short)   // also reverses a long
    shortStop := sellSigStop
if sellSig and inWindow and not shorts and strategy.position_size > 0
    strategy.close("L", comment = "SELL signal")
if strategy.position_size <= 0 and not goLong
    longStop := na
if strategy.position_size >= 0 and not goShort
    shortStop := na

if not na(longStop)
    float e = strategy.position_size > 0 ? strategy.position_avg_price : close
    strategy.exit("L exit", "L", stop = longStop, limit = tpR > 0 ? e + tpR * (e - longStop) : na)
if not na(shortStop)
    float e = strategy.position_size < 0 ? strategy.position_avg_price : close
    strategy.exit("S exit", "S", stop = shortStop, limit = tpR > 0 ? e - tpR * (shortStop - e) : na)

plotshape(buySig,  "BUY",  shape.labelup,   location.belowbar, color.new(#26a69a, 0), text = "BUY",  textcolor = color.white, size = size.small)
plotshape(sellSig, "SELL", shape.labeldown, location.abovebar, color.new(#ef5350, 0), text = "SELL", textcolor = color.white, size = size.small)
plot(strategy.position_size > 0 ? longStop : strategy.position_size < 0 ? shortStop : na, "Stop", color.new(color.gray, 20), 1, plot.style_linebr)
