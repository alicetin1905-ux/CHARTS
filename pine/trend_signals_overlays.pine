// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// Open toolkit modelled on the public feature list of LuxAlgo's "Signals & Overlays".
// Written from scratch with its own math (documented below). It is not LuxAlgo's code, and its signals will differ.
//@version=6
indicator("Trend Signals + Overlays [open]", shorttitle = "TSO", overlay = true, max_labels_count = 500, max_lines_count = 50)

// ───────── Inputs ─────────
grpSig = "Signals"
preset    = input.string("Custom", "Preset", options = ["Custom", "Trend Trader", "Scalper", "Swing Trader"], group = grpSig, tooltip = "Trend Trader: confirmation signals, Smart Trail, Trend Catcher.\nScalper: confirmation signals, gradient candles, Reversal Zones, TP/SL.\nSwing Trader: confirmation signals, autopilot, simple candles, Neo Cloud.\nCustom: use the settings below.")
sigModeIn = input.string("Confirmation + Exits", "Signal mode", options = ["Confirmation + Exits", "Contrarian + Exits", "None"], group = grpSig)
sens      = input.int(12, "Sensitivity", minval = 2, maxval = 50, group = grpSig, tooltip = "Lower = shorter-term signals, higher = longer-term. Confirmation signals are a Supertrend (ATR 10) with factor = sensitivity / 4.")
autoIn    = input.bool(false, "Autopilot sensitivity", group = grpSig, tooltip = "Use the dashboard's optimal sensitivity (best of 10–20 over the last 250 bars) for confirmation signals.")
useClass  = input.bool(true, "Classifier (rate signals 1–4)", group = grpSig, tooltip = "Rates each signal by its trend strength (ADX) against the last 200 signals' quartiles. Confirmation: 3–4 lean to continuation, 1–2 to a possible reversal.")
show1 = input.bool(true, "Show 1", group = grpSig, inline = "cls")
show2 = input.bool(true, "2",      group = grpSig, inline = "cls")
show3 = input.bool(true, "3",      group = grpSig, inline = "cls")
show4 = input.bool(true, "4",      group = grpSig, inline = "cls")

grpOv = "Overlays"
smartIn     = input.bool(true,  "Smart Trail",   group = grpOv, inline = "st")
smartFactor = input.float(3.0,  "Factor", minval = 0.5, step = 0.25, group = grpOv, inline = "st")
rzIn        = input.bool(false, "Reversal Zones", group = grpOv)
tracerIn    = input.bool(false, "Trend Tracer",   group = grpOv)
catcherIn   = input.bool(false, "Trend Catcher",  group = grpOv)
neoIn       = input.bool(false, "Neo Cloud",      group = grpOv)
candleIn    = input.string("Confirmation Simple", "Candle coloring", options = ["None", "Confirmation Simple", "Confirmation Gradient", "Contrarian Gradient"], group = grpOv)

grpTp = "TP/SL"
tpslIn = input.bool(false, "Show TP/SL levels", group = grpTp)
tpDist = input.float(1.5, "Distance (× ATR 14)", minval = 0.1, step = 0.1, group = grpTp, tooltip = "TP1/TP2/TP3 at 1/2/3 × distance from the signal close, stop loss at 1 × distance on the other side. Levels re-anchor when price closes beyond TP3.")

grpDash = "Dashboard"
dashIn     = input.bool(true, "Show dashboard", group = grpDash)
dashPosIn  = input.string("Top right", "Position", options = ["Top right", "Top left", "Bottom right", "Bottom left"], group = grpDash)
dashSizeIn = input.string("Small", "Size", options = ["Tiny", "Small", "Normal"], group = grpDash)

grpCol = "Colors"
bullCol = input.color(#089981, "Bullish",   group = grpCol, inline = "c1")
bearCol = input.color(#f23645, "Bearish",   group = grpCol, inline = "c1")
neutCol = input.color(#9c27b0, "Neutral",   group = grpCol, inline = "c1")
upCol   = input.color(#2962ff, "Uptrend",   group = grpCol, inline = "c2")
dnCol   = input.color(#ff9800, "Downtrend", group = grpCol, inline = "c2")

// Presets override the individual switches
isCustom    = preset == "Custom"
sigMode     = isCustom ? sigModeIn : "Confirmation + Exits"
showSmart   = isCustom ? smartIn   : preset == "Trend Trader"
showCatcher = isCustom ? catcherIn : preset == "Trend Trader"
showRZ      = isCustom ? rzIn      : preset == "Scalper"
showTPSL    = isCustom ? tpslIn    : preset == "Scalper"
showNeo     = isCustom ? neoIn     : preset == "Swing Trader"
showTracer  = isCustom ? tracerIn  : false
autopilot   = isCustom ? autoIn    : preset == "Swing Trader"
candleMode  = isCustom ? candleIn  : preset == "Scalper" ? "Confirmation Gradient" : "Confirmation Simple"
isConf      = sigMode == "Confirmation + Exits"
isContra    = sigMode == "Contrarian + Exits"

// ───────── Helpers ─────────
// ATR-style trailing stop on `src`. Returns [line, direction (1 up / -1 down)].
f_trail(float src, float dist) =>
    var float t = na
    var int d = 1
    float up = src - dist
    float dn = src + dist
    if na(t)
        t := up
    else if d == 1
        t := math.max(t, up)
        if src < t
            d := -1
            t := dn
    else
        t := math.min(t, dn)
        if src > t
            d := 1
            t := up
    [t, d]

// Kaufman adaptive moving average (fast 2, slow 30).
f_kama(float src, int len) =>
    float change = math.abs(src - src[len])
    float noise  = math.sum(math.abs(src - src[1]), len)
    float er     = nz(change / noise)
    float sc     = math.pow(er * (2.0 / 3.0 - 2.0 / 31.0) + 2.0 / 31.0, 2)
    var float k = na
    k := na(k) ? src : k + sc * (src - k)
    k

// Log return of a Supertrend(factor, 10) long/short flip strategy over the last 250 bars.
f_score(float factor) =>
    [stIgnore, d] = ta.supertrend(factor, 10)
    float pos = d < 0 ? 1.0 : -1.0
    var float cum = 0.0
    cum += nz(pos[1]) * nz(math.log(close / close[1]))
    cum - nz(cum[250])

// Classifier: 1–4 by quartile of `x` among earlier signals, then store `x`.
f_rate(array<float> hist, float x) =>
    int r = na
    if hist.size() >= 8
        float q1 = hist.percentile_linear_interpolation(25)
        float q2 = hist.percentile_linear_interpolation(50)
        float q3 = hist.percentile_linear_interpolation(75)
        r := x < q1 ? 1 : x < q2 ? 2 : x < q3 ? 3 : 4
    hist.push(x)
    if hist.size() > 200
        hist.shift()
    r

f_allowed(int r) =>
    na(r) or (r == 1 and show1) or (r == 2 and show2) or (r == 3 and show3) or (r == 4 and show4)

// ───────── Core calculations ─────────
atr14 = ta.atr(14)
rsi14 = ta.rsi(close, 14)
osc   = ta.rsi(close, sens)
emaS  = ta.ema(close, sens)
[diPlus, diMinus, adx] = ta.dmi(14, 14)

// Optimal sensitivity: grid search 10–20 (factor 2.5–5.0) over the last 250 bars
scores  = array.from(f_score(2.5), f_score(2.75), f_score(3.0), f_score(3.25), f_score(3.5), f_score(3.75), f_score(4.0), f_score(4.25), f_score(4.5), f_score(4.75), f_score(5.0))
optSens = 10 + scores.indexof(scores.max())
activeSens = autopilot ? optSens : sens

// Confirmation trend
[stLine, stDir] = ta.supertrend(activeSens / 4.0, 10)
bullFlip = stDir < 0 and stDir[1] > 0
bearFlip = stDir > 0 and stDir[1] < 0

// Trend Tracer: slow trailing stop on a smoothed price
[trLine, trDir] = f_trail(emaS, 2.0 * ta.atr(50))

// Smart Trail: trailing stop on a modified true range that ignores outsized bars and gaps
hl     = high - low
hiLo   = math.min(hl, 1.5 * ta.sma(hl, 21))
hRef   = low <= high[1] ? high - close[1] : (high - close[1]) - 0.5 * (low - high[1])
lRef   = high >= low[1] ? close[1] - low : (close[1] - low) - 0.5 * (low[1] - high)
smLoss = smartFactor * ta.rma(math.max(hiLo, hRef, lRef), 21)
[smTrail, smDir] = f_trail(close, smLoss)
smZone = smDir == 1 ? smTrail + smLoss / 3 : smTrail - smLoss / 3

// Trend Catcher: fast adaptive average
catcher = f_kama(close, sens)
var int caDir = 1
caDir := close > catcher ? 1 : close < catcher ? -1 : caDir

// Neo Cloud: Ichimoku-style midpoints, brighter as the trend ages
neoFast = math.avg(ta.highest(high, 2 * sens), ta.lowest(low, 2 * sens))
neoSlow = math.avg(ta.highest(high, 4 * sens), ta.lowest(low, 4 * sens))
neoBull = neoFast > neoSlow
var int neoAge = 0
neoAge := neoBull != neoBull[1] ? 0 : neoAge + 1

// Reversal Zones: ATR bands around a fast mean
rzBasis = ta.ema(hlc3, 20)
rzAtr   = ta.atr(20)
rzUpIn  = rzBasis + 2 * rzAtr
rzUpOut = rzBasis + 3 * rzAtr
rzLoIn  = rzBasis - 2 * rzAtr
rzLoOut = rzBasis - 3 * rzAtr

// Contrarian triggers
contraBull = ta.crossover(osc, 30)
contraBear = ta.crossunder(osc, 70)
oscLo5     = ta.lowest(osc, 5)
oscHi5     = ta.highest(osc, 5)
oscXUp70   = ta.crossover(osc, 70)
oscXDn30   = ta.crossunder(osc, 30)
rsiXDn70   = ta.crossunder(rsi14, 70)
rsiXUp30   = ta.crossover(rsi14, 30)

// ───────── Signals ─────────
var array<float> confHist   = array.new<float>()
var array<float> contraHist = array.new<float>()
var int cPos = 0
int  sigSide    = 0
bool sigStrong  = false
bool bullExit   = false
bool bearExit   = false

if barstate.isconfirmed
    // Exits first, so they refer to the position held before this bar
    if isConf
        bullExit := stDir < 0 and rsiXDn70 and not bullFlip
        bearExit := stDir > 0 and rsiXUp30 and not bearFlip
    else if isContra
        if cPos == 1 and oscXUp70
            bullExit := true
            cPos := 0
        if cPos == -1 and oscXDn30
            bearExit := true
            cPos := 0

    string txt = ""
    int rate = na
    if isConf and (bullFlip or bearFlip)
        rate := useClass ? f_rate(confHist, adx) : na
        if f_allowed(rate)
            sigSide   := bullFlip ? 1 : -1
            sigStrong := bullFlip ? trDir == 1 : trDir == -1
    else if isContra and (contraBull or contraBear)
        rate := useClass ? f_rate(contraHist, adx) : na
        if f_allowed(rate)
            sigSide   := contraBull ? 1 : -1
            sigStrong := contraBull ? oscLo5 < 20 : oscHi5 > 80
            cPos      := sigSide

    if sigSide != 0
        txt := (sigSide == 1 ? "Buy" : "Sell") + (sigStrong ? "+" : "") + (na(rate) ? "" : " " + str.tostring(rate))
        if sigSide == 1
            label.new(bar_index, low, txt, yloc = yloc.belowbar, style = label.style_label_up, color = bullCol, textcolor = color.white, size = size.small)
        else
            label.new(bar_index, high, txt, yloc = yloc.abovebar, style = label.style_label_down, color = bearCol, textcolor = color.white, size = size.small)
        alert(syminfo.ticker + " " + timeframe.period + ": " + txt + " at " + str.tostring(close, format.mintick), alert.freq_once_per_bar_close)

plotshape(bullExit, "Bullish exit", shape.xcross, location.abovebar, upCol, size = size.tiny)
plotshape(bearExit, "Bearish exit", shape.xcross, location.belowbar, dnCol, size = size.tiny)

// ───────── Overlays ─────────
pSm  = plot(showSmart and smDir == smDir[1] ? smTrail : na, "Smart Trail", smDir == 1 ? upCol : bearCol, 2, plot.style_linebr)
pSmZ = plot(showSmart and smDir == smDir[1] ? smZone : na, "Smart Trail zone", display = display.none)
fill(pSm, pSmZ, color.new(smDir == 1 ? upCol : bearCol, 80), "Smart Trail zone fill")

pUi = plot(showRZ ? rzUpIn  : na, "Upper zone (inner)", color.new(bearCol, 60))
pUo = plot(showRZ ? rzUpOut : na, "Upper zone (outer)", color.new(bearCol, 60))
pLi = plot(showRZ ? rzLoIn  : na, "Lower zone (inner)", color.new(bullCol, 60))
pLo = plot(showRZ ? rzLoOut : na, "Lower zone (outer)", color.new(bullCol, 60))
fill(pUi, pUo, color.new(bearCol, 85), "Upper zone fill")
fill(pLi, pLo, color.new(bullCol, 85), "Lower zone fill")

plot(showTracer and trDir == trDir[1] ? trLine : na, "Trend Tracer", trDir == 1 ? upCol : dnCol, 2, plot.style_linebr)
plot(showCatcher ? catcher : na, "Trend Catcher", caDir == 1 ? upCol : dnCol, 2)

pNf = plot(showNeo ? neoFast : na, "Neo Cloud fast", color.new(neoBull ? upCol : dnCol, 70))
pNs = plot(showNeo ? neoSlow : na, "Neo Cloud slow", color.new(neoBull ? upCol : dnCol, 70))
fill(pNf, pNs, color.new(neoBull ? upCol : dnCol, math.max(50, 88 - neoAge)), "Neo Cloud fill")

// ───────── Candle coloring ─────────
z = (close - emaS) / atr14
confSimple = stDir < 0 and trDir == 1 ? bullCol : stDir > 0 and trDir == -1 ? bearCol : neutCol
confGrad   = z >= 0 ? color.from_gradient(z, 0, 2, neutCol, bullCol) : color.from_gradient(z, -2, 0, bearCol, neutCol)
contraGrad = osc <= 50 ? color.from_gradient(osc, 20, 50, bullCol, color.gray) : color.from_gradient(osc, 50, 80, color.gray, bearCol)
candleCol = switch candleMode
    "Confirmation Simple"   => confSimple
    "Confirmation Gradient" => confGrad
    "Contrarian Gradient"   => contraGrad
    => color(na)
barcolor(candleCol)

// ───────── TP/SL ─────────
var array<line>  tLines  = array.new<line>()
var array<label> tLabels = array.new<label>()
var int   tSide  = 0
var float tEntry = na
var float tUnit  = na
var bool  hit1 = false
var bool  hit2 = false
var bool  hit3 = false
var bool  slHit = false
bool fresh = false

if showTPSL and sigSide != 0
    tSide  := sigSide
    tEntry := close
    tUnit  := tpDist * atr14
    fresh  := true
    for ln in tLines
        ln.delete()
    for lb in tLabels
        lb.delete()
    tLines.clear()
    tLabels.clear()
    for i = 0 to 3
        color c = i < 3 ? bullCol : bearCol
        tLines.push(line.new(bar_index, close, bar_index, close, color = c, style = i < 3 ? line.style_dotted : line.style_dashed, width = 1))
        tLabels.push(label.new(bar_index, close, "", style = label.style_label_left, color = color.new(c, 70), textcolor = color.white, size = size.tiny))

// Re-anchor once price closes beyond TP3
if tSide != 0 and not fresh and barstate.isconfirmed and (tSide == 1 ? close > tEntry + 3 * tUnit : close < tEntry - 3 * tUnit)
    tEntry := close
    tUnit  := tpDist * atr14
    fresh  := true

if fresh
    hit1 := false
    hit2 := false
    hit3 := false
    slHit := false

tp1 = tEntry + tSide * tUnit
tp2 = tEntry + tSide * 2 * tUnit
tp3 = tEntry + tSide * 3 * tUnit
sl  = tEntry - tSide * tUnit

bool tp1Ev = false
bool tp2Ev = false
bool tp3Ev = false
bool slEv  = false
if tSide != 0 and not fresh and not slHit
    if not hit1 and (tSide == 1 ? high >= tp1 : low <= tp1)
        hit1  := true
        tp1Ev := true
    if not hit2 and (tSide == 1 ? high >= tp2 : low <= tp2)
        hit2  := true
        tp2Ev := true
    if not hit3 and (tSide == 1 ? high >= tp3 : low <= tp3)
        hit3  := true
        tp3Ev := true
    if tSide == 1 ? low <= sl : high >= sl
        slHit := true
        slEv  := true

if tLines.size() == 4
    levels = array.from(tp1, tp2, tp3, sl)
    names  = array.from("TP1", "TP2", "TP3", "SL")
    for i = 0 to 3
        float y = levels.get(i)
        line ln = tLines.get(i)
        if fresh
            ln.set_x1(bar_index)
        ln.set_y1(y)
        ln.set_y2(y)
        ln.set_x2(bar_index)
        label lb = tLabels.get(i)
        lb.set_xy(bar_index, y)
        lb.set_text(names.get(i) + " " + str.tostring(y, format.mintick))

plot(tSide != 0 ? tp1 : na, "Take Profit", display = display.data_window)
plot(tSide != 0 ? tp2 : na, "Take Profit 2", display = display.data_window)
plot(tSide != 0 ? tp3 : na, "Take Profit 3", display = display.data_window)
plot(tSide != 0 ? sl  : na, "Stop Loss", display = display.data_window)

// ───────── Dashboard ─────────
[bbMid, bbUp, bbLo] = ta.bb(close, 20, 2.0)
squeeze   = 100 - ta.percentrank((bbUp - bbLo) / bbMid, 100)
trendStr  = math.min(100, adx * 2)
atrLong   = ta.atr(100)
volRatio  = atr14 / atrLong
atrRising = atr14 > atr14[5]
volSent   = 100 * math.sum(volume * (close - open) / math.max(high - low, syminfo.mintick), 20) / math.sum(volume, 20)

dashPos = switch dashPosIn
    "Top left"     => position.top_left
    "Bottom right" => position.bottom_right
    "Bottom left"  => position.bottom_left
    => position.top_right
dSize = switch dashSizeIn
    "Tiny"   => size.tiny
    "Normal" => size.normal
    => size.small

var table dash = table.new(dashPos, 2, 7, bgcolor = color.new(color.black, 80), border_color = color.new(color.gray, 70), border_width = 1)

f_cell(int r, string k, string v, color vc) =>
    table.cell(dash, 0, r, k, text_color = color.silver, text_size = dSize, text_halign = text.align_left)
    table.cell(dash, 1, r, v, text_color = vc, text_size = dSize, text_halign = text.align_right)

if dashIn and barstate.islast
    f_cell(0, "Sensitivity", str.tostring(activeSens) + (autopilot ? " (auto)" : ""), color.white)
    f_cell(1, "Optimal sensitivity", bar_index >= 250 ? str.tostring(optSens) : "n/a", color.white)
    f_cell(2, "Trend", stDir < 0 ? "Bullish ▲" : "Bearish ▼", stDir < 0 ? bullCol : bearCol)
    f_cell(3, "Trend strength", str.tostring(trendStr, "#") + "%", trendStr > 50 ? color.white : color.gray)
    f_cell(4, "Volatility", (volRatio < 1 ? "Stable " : "Volatile ") + (atrRising ? "↑" : "↓") + (volRatio > 1.5 ? " ⚠" : ""), volRatio > 1.5 ? dnCol : color.white)
    f_cell(5, "Squeeze", str.tostring(squeeze, "#") + "%", squeeze > 70 ? dnCol : color.white)
    f_cell(6, "Volume sentiment", na(volSent) ? "n/a" : str.tostring(volSent, "#"), volSent > 0 ? bullCol : volSent < 0 ? bearCol : color.white)

// ───────── Alerts ─────────
// Signals also fire through "Any alert() function call" with the rating in the message.
alertcondition(sigSide == 1,                "Buy",            "{{ticker}} {{interval}}: buy signal")
alertcondition(sigSide == 1 and sigStrong,  "Strong buy",     "{{ticker}} {{interval}}: strong buy signal")
alertcondition(sigSide == -1,               "Sell",           "{{ticker}} {{interval}}: sell signal")
alertcondition(sigSide == -1 and sigStrong, "Strong sell",    "{{ticker}} {{interval}}: strong sell signal")
alertcondition(bullExit,                    "Bullish exit",   "{{ticker}} {{interval}}: bullish exit")
alertcondition(bearExit,                    "Bearish exit",   "{{ticker}} {{interval}}: bearish exit")
alertcondition(smDir == 1 and smDir[1] == -1,  "Smart Trail bullish",   "{{ticker}} {{interval}}: price broke above the Smart Trail")
alertcondition(smDir == -1 and smDir[1] == 1,  "Smart Trail bearish",   "{{ticker}} {{interval}}: price broke below the Smart Trail")
alertcondition(trDir == 1 and trDir[1] == -1,  "Trend Tracer bullish",  "{{ticker}} {{interval}}: Trend Tracer turned up")
alertcondition(trDir == -1 and trDir[1] == 1,  "Trend Tracer bearish",  "{{ticker}} {{interval}}: Trend Tracer turned down")
alertcondition(caDir == 1 and caDir[1] == -1,  "Trend Catcher bullish", "{{ticker}} {{interval}}: Trend Catcher turned up")
alertcondition(caDir == -1 and caDir[1] == 1,  "Trend Catcher bearish", "{{ticker}} {{interval}}: Trend Catcher turned down")
alertcondition(neoBull and not neoBull[1],     "Neo Cloud bullish",     "{{ticker}} {{interval}}: Neo Cloud turned bullish")
alertcondition(not neoBull and neoBull[1],     "Neo Cloud bearish",     "{{ticker}} {{interval}}: Neo Cloud turned bearish")
alertcondition(ta.crossover(high, rzUpIn),     "Enter upper reversal zone", "{{ticker}} {{interval}}: price entered the upper reversal zone")
alertcondition(ta.crossunder(low, rzLoIn),     "Enter lower reversal zone", "{{ticker}} {{interval}}: price entered the lower reversal zone")
alertcondition(tp1Ev, "TP1 hit",       "{{ticker}} {{interval}}: TP1 reached")
alertcondition(tp2Ev, "TP2 hit",       "{{ticker}} {{interval}}: TP2 reached")
alertcondition(tp3Ev, "TP3 hit",       "{{ticker}} {{interval}}: TP3 reached")
alertcondition(slEv,  "Stop loss hit", "{{ticker}} {{interval}}: stop loss reached")
