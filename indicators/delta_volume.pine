// Delta volume (buy volume - sell volume) per bar and cumulative (CVD), built for BINANCE:BTCUSDT.P / BYBIT:BTCUSDT.P.
//
// Pine Script cannot see who was the aggressor in each trade, so delta is estimated from lower-timeframe
// candles, the same way TradingView's built-in Volume Delta does it:
//   - each intrabar (1m by default) counts as buy volume if it closed up, sell volume if it closed down;
//   - an intrabar that closed flat takes the direction of the price change from the previous intrabar
//     (or of the last direction if the price did not change either).
// Bars older than the intrabar history TradingView provides (about 100,000 intrabars, plan dependent) fall
// back to the chart bar: buy share = (close - low) / (high - low). They are drawn faded and counted in the table.
//
// Delta candles: open = 0, high / low = highest / lowest running delta inside the bar, close = bar delta.
// CVD candles  : the same, starting from the previous bar's CVD.
//
// Divergence: pivot highs / lows in price (pivot bars left / right) are compared with the previous pivot of the
// same kind 5-60 bars earlier. Bullish = price lower low, CVD higher low. Bearish = price higher high, CVD lower
// high. Hidden divergences (optional) are the reverse. A signal appears 'pivot bars right' bars after the pivot.
// Buy / sell: a divergence arms a trigger (highest high / lowest low since the pivot); a close through it with
// matching delta within 'Bars to confirm' bars is the signal, unless price breaks the pivot first.

//@version=6
indicator("Delta Volume [BTCUSDT.P]", shorttitle = "Delta Vol", format = format.volume, max_lines_count = 500, max_labels_count = 500)

grpData = "Data"
useChart  = input.bool(true, "Use chart symbol", group = grpData)
symInput  = input.symbol("BINANCE:BTCUSDT.P", "Symbol", group = grpData, tooltip = "Used when 'Use chart symbol' is off.")
autoLtf   = input.bool(true, "Auto lower timeframe", group = grpData,
     tooltip = "Seconds chart: 1S. Intraday: 1m. Daily: 5m. Weekly and up: 1H. A lower timeframe is more precise but covers less history.")
ltfInput  = input.timeframe("1", "Lower timeframe", group = grpData)
unitInput = input.string("Coin (BTC)", "Volume unit", options = ["Coin (BTC)", "Quote (USDT)"], group = grpData)

grpView = "Display"
modeInput   = input.string("Delta candles", "Show", options = ["Delta candles", "Delta columns", "Cumulative delta (CVD)"], group = grpView)
anchorInput = input.string("None", "CVD reset", options = ["None", "Day", "Week", "Month"], group = grpView)
showMa      = input.bool(true, "Moving average", inline = "ma", group = grpView)
maLen       = input.int(20, "", minval = 1, inline = "ma", group = grpView)
showTable   = input.bool(true, "Stats table", group = grpView)
upColor     = input.color(#26a69a, "Buy", inline = "col", group = grpView)
dnColor     = input.color(#ef5350, "Sell", inline = "col", group = grpView)

grpDiv = "Price / CVD divergence"
showDiv    = input.bool(true, "Regular divergences", group = grpDiv,
     tooltip = "Bullish: price makes a lower low, CVD a higher low (selling is drying up). Bearish: price makes a higher high, CVD a lower high (buying is drying up).")
showHidden = input.bool(false, "Hidden divergences", group = grpDiv,
     tooltip = "Bullish: price makes a higher low, CVD a lower low. Bearish: price makes a lower high, CVD a higher high. Read as trend continuation.")
pivLeft    = input.int(5, "Pivot bars left", minval = 1, group = grpDiv)
pivRight   = input.int(3, "Pivot bars right", minval = 1, group = grpDiv,
     tooltip = "A pivot is confirmed this many bars after it, so signals and alerts arrive that many bars late. The marks are drawn back on the pivot bar.")
rangeMin   = input.int(5, "Min bars between pivots", minval = 1, group = grpDiv)
rangeMax   = input.int(60, "Max bars between pivots", minval = 2, group = grpDiv)
divOnPrice = input.bool(true, "Draw on price chart", group = grpDiv, tooltip = "Lines and labels on the candles. Only when 'Use chart symbol' is on.")
bullColor  = input.color(#00e676, "Bullish", inline = "dcol", group = grpDiv)
bearColor  = input.color(#ff9100, "Bearish", inline = "dcol", group = grpDiv)

grpSig = "Buy / sell signals"
showSignals = input.bool(true, "Show buy / sell signals", group = grpSig,
     tooltip = "After a bullish divergence: BUY when a candle closes above the highest high from the pivot low to the bar the divergence was found. Cancelled if price trades below the pivot low first, if a bearish divergence appears, or after 'Bars to confirm'. SELL is the mirror image.")
sigHidden   = input.bool(false, "Also from hidden divergences", group = grpSig)
confirmBars = input.int(10, "Bars to confirm", minval = 1, group = grpSig)
needDelta   = input.bool(true, "Confirmation candle needs matching delta", group = grpSig,
     tooltip = "BUY only on a candle with positive delta, SELL only on negative delta.")

sym     = useChart ? syminfo.tickerid : symInput
ltf     = autoLtf ? (timeframe.isseconds ? "1S" : timeframe.isintraday ? "1" : timeframe.isdaily ? "5" : "60") : ltfInput
isQuote = unitInput == "Quote (USDT)"

if timeframe.in_seconds(ltf) > timeframe.in_seconds()
    runtime.error("The lower timeframe (" + ltf + ") must not be higher than the chart timeframe.")

[ltfO, ltfC, ltfV] = request.security_lower_tf(sym, ltf, [open, close, volume])
[o, h, l, c, v]    = request.security(sym, timeframe.period, [open, high, low, close, volume])

// Direction of the last intrabar that moved, carried across chart bars for the tick rule.
var float lastDir   = 1.0
var float lastClose = na

float buyVol  = 0.0
float sellVol = 0.0
float delta   = 0.0
float hiDelta = 0.0
float loDelta = 0.0
int   n       = ltfC.size()
bool  isFallback = n == 0

if not isFallback
    for i = 0 to n - 1
        float ic = ltfC.get(i)
        float io = ltfO.get(i)
        float iv = nz(ltfV.get(i)) * (isQuote ? ic : 1.0)
        float dir = ic > io ? 1.0 : ic < io ? -1.0 : ic > lastClose ? 1.0 : ic < lastClose ? -1.0 : lastDir
        if dir > 0
            buyVol += iv
        else
            sellVol += iv
        delta   += dir * iv
        hiDelta := math.max(hiDelta, delta)
        loDelta := math.min(loDelta, delta)
        lastDir   := dir
        lastClose := ic
else
    float vol      = nz(v) * (isQuote ? c : 1.0)
    float buyShare = h > l ? (c - l) / (h - l) : c > o ? 1.0 : c < o ? 0.0 : 0.5
    buyVol  := vol * buyShare
    sellVol := vol - buyVol
    delta   := buyVol - sellVol
    hiDelta := math.max(delta, 0.0)
    loDelta := math.min(delta, 0.0)
    if not na(c)
        lastClose := c

totalVol = buyVol + sellVol
deltaPct = totalVol > 0 ? 100 * delta / totalVol : 0.0

// Cumulative delta with an optional periodic reset.
bool reset = switch anchorInput
    "Day"   => timeframe.change("D")
    "Week"  => timeframe.change("W")
    "Month" => timeframe.change("M")
    => false
var float cvd = 0.0
float cvdOpen = reset ? 0.0 : cvd
cvd := cvdOpen + delta
var int lastResetBar = 0
if reset
    lastResetBar := bar_index

isCandles = modeInput == "Delta candles"
isColumns = modeInput == "Delta columns"
isCvd     = modeInput == "Cumulative delta (CVD)"

// Divergence: find pivots in price, compare CVD at the same bars with the previous pivot of the same kind.
// Pairs that straddle a CVD reset are skipped, since their CVD values are not comparable.
pivLow    = ta.pivotlow(l, pivLeft, pivRight)
pivHigh   = ta.pivothigh(h, pivLeft, pivRight)
pivBar    = bar_index - pivRight
cvdAtPiv  = cvd[pivRight]

var float prevLowPrice  = na
var float prevLowCvd    = na
var int   prevLowBar    = na
var float prevHighPrice = na
var float prevHighCvd   = na
var int   prevHighBar   = na

bool bullDiv    = false
bool hidBullDiv = false
bool bearDiv    = false
bool hidBearDiv = false

drawDiv(int x1, float p1, float c1, float p2, float c2, bool isBull, bool isHidden) =>
    color col  = isBull ? bullColor : bearColor
    string sty = isHidden ? line.style_dashed : line.style_solid
    if isCvd
        line.new(x1, c1, pivBar, c2, color = col, width = 2, style = sty)
    if divOnPrice and useChart
        line.new(x1, p1, pivBar, p2, color = col, width = 2, style = sty, force_overlay = true)
        label.new(pivBar, p2, (isHidden ? "H " : "") + (isBull ? "Bull" : "Bear"), color = col, textcolor = color.black,
             style = isBull ? label.style_label_up : label.style_label_down, size = size.small, force_overlay = true)

if not na(pivLow)
    int dist = pivBar - prevLowBar
    if not na(prevLowBar) and dist >= rangeMin and dist <= rangeMax and lastResetBar <= prevLowBar
        bullDiv    := pivLow < prevLowPrice and cvdAtPiv > prevLowCvd
        hidBullDiv := pivLow > prevLowPrice and cvdAtPiv < prevLowCvd
        if (showDiv and bullDiv) or (showHidden and hidBullDiv)
            drawDiv(prevLowBar, prevLowPrice, prevLowCvd, pivLow, cvdAtPiv, true, hidBullDiv)
    prevLowPrice := pivLow
    prevLowCvd   := cvdAtPiv
    prevLowBar   := pivBar

if not na(pivHigh)
    int dist = pivBar - prevHighBar
    if not na(prevHighBar) and dist >= rangeMin and dist <= rangeMax and lastResetBar <= prevHighBar
        bearDiv    := pivHigh > prevHighPrice and cvdAtPiv < prevHighCvd
        hidBearDiv := pivHigh < prevHighPrice and cvdAtPiv > prevHighCvd
        if (showDiv and bearDiv) or (showHidden and hidBearDiv)
            drawDiv(prevHighBar, prevHighPrice, prevHighCvd, pivHigh, cvdAtPiv, false, hidBearDiv)
    prevHighPrice := pivHigh
    prevHighCvd   := cvdAtPiv
    prevHighBar   := pivBar

// Buy / sell: a divergence arms a trigger level, a close through it (before the pivot breaks) confirms it.
// Pending triggers are checked before new ones are armed, so a signal comes at the earliest on the next bar.
hiSincePiv = ta.highest(h, pivRight + 1)
loSincePiv = ta.lowest(l, pivRight + 1)

var float buyLevel   = na
var float buyStop    = na
var int   buyExpire  = na
var float sellLevel  = na
var float sellStop   = na
var int   sellExpire = na

bool buySig  = false
bool sellSig = false
float sigStop = na

if not na(buyLevel)
    if l < buyStop or bar_index > buyExpire
        buyLevel := na
    else if c > buyLevel and (not needDelta or delta > 0)
        buySig   := true
        sigStop  := buyStop
        buyLevel := na
if not na(sellLevel)
    if h > sellStop or bar_index > sellExpire
        sellLevel := na
    else if c < sellLevel and (not needDelta or delta < 0)
        sellSig   := true
        sigStop   := sellStop
        sellLevel := na

bool newBull = bullDiv or (sigHidden and hidBullDiv)
bool newBear = bearDiv or (sigHidden and hidBearDiv)
if newBull
    buyLevel  := hiSincePiv
    buyStop   := pivLow
    buyExpire := bar_index + confirmBars
    if not newBear
        sellLevel := na
if newBear
    sellLevel  := loSincePiv
    sellStop   := pivHigh
    sellExpire := bar_index + confirmBars
    if not newBull
        buyLevel := na

fade     = isFallback ? 50 : 0
barColor = color.new(delta >= 0 ? upColor : dnColor, fade)

plotcandle(isCandles ? 0.0 : na, isCandles ? hiDelta : na, isCandles ? loDelta : na, isCandles ? delta : na,
     "Delta candles", barColor, barColor, bordercolor = barColor)
plot(isColumns ? delta : na, "Delta", barColor, style = plot.style_columns)
plotcandle(isCvd ? cvdOpen : na, isCvd ? cvdOpen + hiDelta : na, isCvd ? cvdOpen + loDelta : na, isCvd ? cvd : na,
     "CVD candles", barColor, barColor, bordercolor = barColor)

ma = ta.ema(isCvd ? cvd : delta, maLen)
plot(showMa ? ma : na, "Moving average", color.new(color.orange, 0), 2)
hline(0, "Zero", color.new(color.gray, 50), hline.style_dotted)

// Divergence marks in the pane, on the pivot bar (confirmed pivRight bars later).
plotshape(showDiv and bullDiv, "Bullish divergence", shape.triangleup, location.bottom, bullColor, offset = -pivRight, size = size.tiny)
plotshape(showDiv and bearDiv, "Bearish divergence", shape.triangledown, location.top, bearColor, offset = -pivRight, size = size.tiny)
plotshape(showHidden and hidBullDiv, "Hidden bullish divergence", shape.circle, location.bottom, bullColor, offset = -pivRight, size = size.tiny)
plotshape(showHidden and hidBearDiv, "Hidden bearish divergence", shape.circle, location.top, bearColor, offset = -pivRight, size = size.tiny)

// Signals in the pane, and on the candles with the pending trigger levels.
onPrice = showSignals and useChart
plotshape(showSignals and buySig,  "Buy",  shape.labelup,   location.bottom, upColor, text = "BUY",  textcolor = color.white, size = size.small)
plotshape(showSignals and sellSig, "Sell", shape.labeldown, location.top,    dnColor, text = "SELL", textcolor = color.white, size = size.small)
plotshape(onPrice and buySig,  "Buy (price)",  shape.labelup,   location.belowbar, upColor, text = "BUY",  textcolor = color.white, size = size.small, force_overlay = true)
plotshape(onPrice and sellSig, "Sell (price)", shape.labeldown, location.abovebar, dnColor, text = "SELL", textcolor = color.white, size = size.small, force_overlay = true)
plot(onPrice ? buyLevel : na,  "Buy trigger",  color.new(upColor, 30), 1, plot.style_linebr, force_overlay = true)
plot(onPrice ? sellLevel : na, "Sell trigger", color.new(dnColor, 30), 1, plot.style_linebr, force_overlay = true)

// Data window values.
plot(buyVol,   "Buy volume",  upColor, display = display.data_window)
plot(sellVol,  "Sell volume", dnColor, display = display.data_window)
plot(deltaPct, "Delta %",     color.gray, display = display.data_window)
plot(cvd,      "CVD",         color.gray, display = display.data_window)

var int fallbackBars = 0
if isFallback
    fallbackBars += 1

var table stats = table.new(position.top_right, 2, 7, bgcolor = color.new(color.black, 80), border_width = 1)
if showTable and barstate.islast
    unit = isQuote ? " USDT" : " " + syminfo.basecurrency
    rows = array.from("Buy volume", "Sell volume", "Delta", "Delta %", "CVD", "Lower TF", "Fallback bars")
    vals = array.from(str.tostring(buyVol, format.volume) + unit, str.tostring(sellVol, format.volume) + unit,
         str.tostring(delta, format.volume) + unit, str.tostring(deltaPct, "0.0") + "%",
         str.tostring(cvd, format.volume) + unit, ltf + (isFallback ? " (n/a)" : " x" + str.tostring(n)),
         str.tostring(fallbackBars))
    for i = 0 to rows.size() - 1
        color valColor = i == 2 or i == 3 ? (delta >= 0 ? upColor : dnColor) : i == 4 ? (cvd >= 0 ? upColor : dnColor) : color.white
        stats.cell(0, i, rows.get(i), text_color = color.silver, text_size = size.small, text_halign = text.align_left)
        stats.cell(1, i, vals.get(i), text_color = valColor, text_size = size.small, text_halign = text.align_right)

alertcondition(ta.crossover(delta, 0),  "Delta turns positive", "Delta volume turned positive on {{ticker}}")
alertcondition(ta.crossunder(delta, 0), "Delta turns negative", "Delta volume turned negative on {{ticker}}")
alertcondition(ta.crossover(cvd, ta.ema(cvd, maLen)),  "CVD crosses above its EMA", "CVD crossed above its EMA on {{ticker}}")
alertcondition(ta.crossunder(cvd, ta.ema(cvd, maLen)), "CVD crosses below its EMA", "CVD crossed below its EMA on {{ticker}}")
alertcondition(bullDiv,    "Bullish divergence",        "Bullish price / CVD divergence on {{ticker}}")
alertcondition(bearDiv,    "Bearish divergence",        "Bearish price / CVD divergence on {{ticker}}")
alertcondition(hidBullDiv, "Hidden bullish divergence", "Hidden bullish price / CVD divergence on {{ticker}}")
alertcondition(hidBearDiv, "Hidden bearish divergence", "Hidden bearish price / CVD divergence on {{ticker}}")
alertcondition(buySig,  "Buy signal",  "BUY: bullish price / CVD divergence confirmed on {{ticker}} at {{close}}")
alertcondition(sellSig, "Sell signal", "SELL: bearish price / CVD divergence confirmed on {{ticker}} at {{close}}")
// For 'Any alert() function call' alerts, with the invalidation level (the divergence pivot).
if buySig or sellSig
    alert((buySig ? "BUY " : "SELL ") + syminfo.ticker + " at " + str.tostring(c, format.mintick) +
         ", divergence invalid beyond " + str.tostring(sigStop, format.mintick), alert.freq_once_per_bar_close)
